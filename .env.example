# Copy this file to .env and fill in your values.
# .env is git-ignored — your settings stay local and are never shared.
#
# Setup:
#   cp .env.example .env       (Mac/Linux)
#   copy .env.example .env     (Windows)
# Then edit .env with your own name and preferred settings.

# Using Claude subscription via `claude auth login` — no API key needed
# ANTHROPIC_API_KEY=...

# ── Developer monitoring (local only — never commit) ──────────────────────────

# Your name — shows up in cost_log.jsonl so you can compare runs across teammates
PIPELINE_USER=yourname

# Show detailed token/cache/cost panels in terminal
# Set to 0 for clean output (what end users see by default)
PIPELINE_VERBOSE=1

# Optional experiment labels written to .pipeline_state/cost_log.jsonl.
# Use these to compare before/after runs when testing a skill, plugin, prompt,
# or a specific code change.
# PIPELINE_EXPERIMENT_ID=skill-odoo-fix-v2
# PIPELINE_CHANGE_ID=cursor-db-timeout-line-42
# PIPELINE_PROMPT_VARIANT=planning-v2
# PIPELINE_SKILLS=odoo-fix
# PIPELINE_PLUGINS=repo-linter

# Enable OpenTelemetry instrumentation only when you want Jaeger/Grafana traces.
# The JSONL cost log works without this.
# Requires: pip install opentelemetry-api opentelemetry-sdk opentelemetry-exporter-otlp-proto-http
PIPELINE_OTEL_ENABLED=0

# Print OTel output to terminal (no backend / Grafana needed)
# OTEL_TRACES_EXPORTER=console
# OTEL_METRICS_EXPORTER=console
# OTEL_LOGS_EXPORTER=console

# Service label and resource tags visible in OTel backend (optional)
OTEL_SERVICE_NAME=sentry-claude-pipeline
OTEL_RESOURCE_ATTRIBUTES=developer.name=yourname,environment=dev

# ── If you have a local Jaeger or Grafana running ─────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Sensitive — only uncomment locally, NEVER in CI or shared envs ────────────
# OTEL_LOG_USER_PROMPTS=1    # exports full prompt text in span attributes
# OTEL_LOG_TOOL_DETAILS=1    # exports tool call inputs/outputs
